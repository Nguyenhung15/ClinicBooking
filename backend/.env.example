NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/clinic_booking
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
CLINIC_TIME_ZONE=Asia/Ho_Chi_Minh

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional: First-Admin Bootstrap Protection (UC-ADM-10)
ADMIN_BOOTSTRAP_SECRET=
ADMIN_BOOTSTRAP_REQUIRE_SECRET=false

# Optional: Appointment Limits (UC-PAT-04)
MAX_PATIENTS_PER_APPOINTMENT=4
MAX_PENDING_APPOINTMENTS_PER_PATIENT=5

# Optional: Appointment Cancellation Limits (UC-PAT-06)
CANCEL_MIN_HOURS=24
CANCEL_LOCK_THRESHOLD=3
