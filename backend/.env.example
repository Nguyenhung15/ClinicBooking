# Server & Environment
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Database & Múi giờ
MONGO_URI=mongodb://127.0.0.1:27017/clinic_booking
CLINIC_TIMEZONE=Asia/Ho_Chi_Minh
ENABLE_MONGO_TRANSACTIONS=false

# Security & JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Transactional Outbox & Notification Worker
OUTBOX_ENABLE_WORKER=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_MAX_RETRIES=5

# First-Admin Bootstrap Protection (UC-ADM-10)
ADMIN_BOOTSTRAP_SECRET=
ADMIN_BOOTSTRAP_REQUIRE_SECRET=false

# Appointment Business Rules
MAX_PATIENTS_PER_APPOINTMENT=4
MAX_PENDING_APPOINTMENTS_PER_PATIENT=5
CANCEL_MIN_HOURS=24
CANCEL_LOCK_THRESHOLD=3
BOOKING_LOCK_DURATION_HOURS=24
